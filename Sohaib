<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b0b0c">
<title>Personal Signature</title>
<style>
:root{--bg:#0b0b0c;--glow:#1f1b11;--c1:#171716;--c2:#101011;--ivory:#f1e9d8;--muted:#a9a293;--accent:#c8a85a;--g1:#e6cf8e;--g2:#b59443;--on:#17130a;--line:rgba(200,168,90,.28)}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{min-height:100vh;background:radial-gradient(120% 60% at 50% 0%,var(--glow) 0%,var(--bg) 62%);color:var(--ivory);font-family:system-ui,-apple-system,"Segoe UI",Roboto,Tahoma,Arial,sans-serif;display:flex;justify-content:center;padding:28px 16px calc(28px + env(safe-area-inset-bottom))}
.wrap{width:100%;max-width:440px}
.card{background:linear-gradient(180deg,var(--c1),var(--c2));border:1px solid var(--line);border-radius:24px;padding:36px 24px 26px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.55)}
.avatar{width:128px;height:128px;margin:0 auto 22px;border-radius:50%;padding:4px;background:linear-gradient(135deg,var(--g1),var(--g2))}
.avatar img,.avatar .ini{width:100%;height:100%;border-radius:50%;object-fit:cover;display:flex;align-items:center;justify-content:center;background:var(--c1);border:3px solid var(--c2)}
.avatar.sq{width:160px;height:160px;border-radius:26px}
.avatar.sq img{border-radius:22px;object-fit:contain;padding:12px}
.ini{font-family:Georgia,serif;font-size:42px;color:var(--accent)}
h1{font-family:Georgia,"Times New Roman",serif;font-weight:500;font-size:30px;line-height:1.3;letter-spacing:.5px}
.title{margin-top:10px;color:var(--accent);font-size:13px;letter-spacing:2px;text-transform:uppercase}
.company{margin-top:6px;color:var(--muted);font-size:14px}
.rule{width:56px;height:1px;background:var(--accent);margin:22px auto}
.bio{color:var(--muted);font-size:15px;line-height:1.85}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:26px}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:14px 10px;border-radius:14px;border:1px solid var(--line);color:var(--ivory);text-decoration:none;font-size:15px;background:transparent;font-family:inherit;cursor:pointer;width:100%}
.btn svg,.row svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.btn.full{grid-column:1/-1}
.btn.gold{grid-column:1/-1;background:linear-gradient(135deg,var(--g1),var(--g2));color:var(--on);border:0;font-weight:700}
.btn:active{transform:scale(.98)}
.info{margin-top:22px;text-align:start;border-top:1px solid var(--line)}
.row{display:flex;gap:14px;align-items:center;padding:15px 4px;border-bottom:1px solid var(--line);color:var(--ivory);text-decoration:none;font-size:15px;word-break:break-word}
.row svg{color:var(--accent)}
.social{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:24px}
.chip{display:flex;align-items:center;gap:7px;padding:9px 16px;border:1px solid var(--line);border-radius:999px;color:var(--ivory);text-decoration:none;font-size:14px}
.chip svg{width:15px;height:15px;stroke:var(--accent);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.ltr{direction:ltr;unicode-bidi:embed}
</style>
</head>
<body>
<div class="wrap"><div class="card" id="card"></div></div>

<script>
/* =====================================================
   بيانات الزبون — عدّل هذا القسم فقط
   اترك أي حقل فارغ "" وسيختفي من الصفحة تلقائياً
   ===================================================== */
const CARD = {
  lang: "en",             // اللغة: "ar" أو "fr" أو "en"
  theme: "royal",         // الألوان: "gold" أو "royal" أو "rose" أو "blue" أو "green"
  countryCode: "213",

  firstName: "Sohaib",
  lastName: "Abu Dergham",
  title: "Trader",
  company: "Mobile Trader",
  bio: "I provide services that help your business grow.",

  image: "photo.jpg",     // صورة أو شعار، مثال: "photo.jpg" (في نفس المجلد)
  imageShape: "circle",   // "circle" للصورة الشخصية، "square" للشعار
  showInitials: true,     // false = لا شيء إذا لم توجد صورة

  buttons: ["call", "whatsapp", "save"],   // الأزرار الكبيرة، الخيارات: call whatsapp email website map save
  info: ["phone", "email", "address", "website"],  // الأسطر السفلية، الخيارات: phone email address website

  phone: "0664 83 75 70",
  whatsapp: "",           // فارغ = نفس رقم الهاتف
  email: "",
  address: "Bach Djerrah, Algiers",
  mapLink: "https://maps.app.goo.gl/VVYLQeiujfSFJFKA7",
  website: "",
  social: [
    { name: "Instagram", url: "https://www.instagram.com/sohaib4ummah" },
    { name: "Facebook",  url: "https://www.facebook.com/share/1RX8jZazi6/" },
    { name: "TikTok",    url: "https://vm.tiktok.com/ZS9DoAu3UjcN3-f4hzn/" }
  ]
};
/* ================= نهاية قسم البيانات ================= */

const TH = {
  gold:  { bg:"#0b0b0c", glow:"#1f1b11", c1:"#171716", c2:"#101011", ivory:"#f1e9d8", muted:"#a9a293", accent:"#c8a85a", g1:"#e6cf8e", g2:"#b59443", on:"#17130a" },
  royal: { bg:"#06130d", glow:"#0f2b1d", c1:"#0d2018", c2:"#091810", ivory:"#f2ecda", muted:"#aab8ad", accent:"#cdb36a", g1:"#e6d6a2", g2:"#b99b4c", on:"#14110a" },
  rose:  { bg:"#151315", glow:"#2b2126", c1:"#262327", c2:"#1d1b1e", ivory:"#f6ecee", muted:"#b3a8ac", accent:"#e08fa6", g1:"#f2b3c4", g2:"#d1708b", on:"#2a0f18" },
  blue:  { bg:"#0a1118", glow:"#12202e", c1:"#14202b", c2:"#0f1923", ivory:"#e9f1f7", muted:"#9fb2c1", accent:"#5cb3d6", g1:"#8fd3ec", g2:"#3a8fb3", on:"#06202c" },
  green: { bg:"#0c110e", glow:"#15231a", c1:"#16201a", c2:"#101813", ivory:"#eef3ea", muted:"#a3b2a5", accent:"#7bb88a", g1:"#a6d9b0", g2:"#4f9a62", on:"#08210f" }
};
const TX = {
  ar: { call:"اتصال", wa:"واتساب", email:"البريد", site:"الموقع", map:"الخريطة", save:"حفظ جهة الاتصال" },
  fr: { call:"Appeler", wa:"WhatsApp", email:"E-mail", site:"Site web", map:"Itinéraire", save:"Enregistrer le contact" },
  en: { call:"Call", wa:"WhatsApp", email:"Email", site:"Website", map:"Map", save:"Save contact" }
};
const T = TX[CARD.lang] || TX.ar;

const esc = s => String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const safeUrl = u => /^https?:\/\//i.test(u || "") ? u : "";
const isWeb = u => /^https?:\/\//i.test(u);
const rgba = (h, a) => { const n = parseInt(h.replace("#", ""), 16); return "rgba(" + (n >> 16 & 255) + "," + (n >> 8 & 255) + "," + (n & 255) + "," + a + ")"; };
const intl = n => {
  let d = String(n || "").replace(/\D/g, "");
  if (d.startsWith("00")) d = d.slice(2);
  else if (d.startsWith("0")) d = CARD.countryCode + d.slice(1);
  return d;
};
const ic = {
  phone: '<svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  wa: '<svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>',
  mail: '<svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
  pin: '<svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
  add: '<svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>',
  link: '<svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>'
};

const full = ((CARD.firstName || "") + " " + (CARD.lastName || "")).trim();
const num = intl(CARD.phone);
const waNum = intl(CARD.whatsapp || CARD.phone);

/* الألوان واللغة */
const th = TH[CARD.theme] || TH.gold;
const root = document.documentElement;
for (const k in th) root.style.setProperty("--" + k, th[k]);
root.style.setProperty("--line", rgba(th.accent, .28));
document.querySelector('meta[name="theme-color"]').setAttribute("content", th.bg);
root.lang = CARD.lang;
root.dir = CARD.lang === "ar" ? "rtl" : "ltr";
document.title = full + (CARD.title ? " — " + CARD.title : "");

/* الصورة أو الشعار */
let h = "";
const initials = (((CARD.firstName || "")[0] || "") + ((CARD.lastName || "")[0] || "")).toUpperCase();
if (CARD.image) h += '<div class="avatar' + (CARD.imageShape === "square" ? ' sq' : '') + '"><img src="' + esc(CARD.image) + '" alt="' + esc(full) + '"></div>';
else if (CARD.showInitials !== false && initials) h += '<div class="avatar"><div class="ini">' + esc(initials) + '</div></div>';

h += '<h1>' + esc(full) + '</h1>';
if (CARD.title) h += '<div class="title">' + esc(CARD.title) + '</div>';
if (CARD.company) h += '<div class="company">' + esc(CARD.company) + '</div>';
if (CARD.bio) h += '<div class="rule"></div><p class="bio">' + esc(CARD.bio) + '</p>';

/* الأزرار الكبيرة */
const B = {
  call:     () => num && ['tel:+' + num, ic.phone, T.call],
  whatsapp: () => waNum && ['https://wa.me/' + waNum, ic.wa, T.wa],
  email:    () => CARD.email && ['mailto:' + CARD.email, ic.mail, T.email],
  website:  () => safeUrl(CARD.website) && [CARD.website, ic.link, T.site],
  map:      () => safeUrl(CARD.mapLink) && [CARD.mapLink, ic.pin, T.map]
};
const want = CARD.buttons || [];
const btns = want.filter(k => k !== "save").map(k => B[k] && B[k]()).filter(Boolean);
let a = btns.map((b, i) => '<a class="btn' + (btns.length % 2 && i === btns.length - 1 ? ' full' : '') + '" href="' + esc(b[0]) + '"' + (isWeb(b[0]) ? ' target="_blank" rel="noopener"' : '') + '>' + b[1] + b[2] + '</a>').join("");
if (want.includes("save")) a += '<button class="btn gold" id="save" type="button">' + ic.add + T.save + '</button>';
if (a) h += '<div class="actions">' + a + '</div>';

/* الأسطر السفلية */
const R = {
  phone:   () => CARD.phone && ['tel:+' + num, ic.phone, CARD.phone, 1],
  email:   () => CARD.email && ['mailto:' + CARD.email, ic.mail, CARD.email, 1],
  address: () => CARD.address && [safeUrl(CARD.mapLink), ic.pin, CARD.address, 0],
  website: () => safeUrl(CARD.website) && [CARD.website, ic.link, CARD.website.replace(/^https?:\/\//i, ""), 1]
};
const rows = (CARD.info || []).map(k => R[k] && R[k]()).filter(Boolean).map(r => {
  const inner = r[1] + '<span' + (r[3] ? ' class="ltr"' : '') + '>' + esc(r[2]) + '</span>';
  return r[0] ? '<a class="row" href="' + esc(r[0]) + '"' + (isWeb(r[0]) ? ' target="_blank" rel="noopener"' : '') + '>' + inner + '</a>' : '<div class="row">' + inner + '</div>';
}).join("");
if (rows) h += '<div class="info">' + rows + '</div>';

/* حسابات التواصل */
const soc = (CARD.social || []).filter(s => safeUrl(s.url));
if (soc.length) h += '<div class="social">' + soc.map(s => '<a class="chip" href="' + esc(s.url) + '" target="_blank" rel="noopener">' + ic.link + esc(s.name) + '</a>').join("") + '</div>';

document.getElementById("card").innerHTML = h;

/* حفظ جهة الاتصال (vCard) */
const v = s => String(s).replace(/([,;\\])/g, "\\$1").replace(/\n/g, "\\n");
const saveBtn = document.getElementById("save");
if (saveBtn) saveBtn.addEventListener("click", () => {
  const L = ["BEGIN:VCARD", "VERSION:3.0", "N:" + v(CARD.lastName || "") + ";" + v(CARD.firstName || "") + ";;;", "FN:" + v(full)];
  if (CARD.company) L.push("ORG:" + v(CARD.company));
  if (CARD.title) L.push("TITLE:" + v(CARD.title));
  if (num) L.push("TEL;TYPE=CELL:+" + num);
  if (CARD.email) L.push("EMAIL:" + v(CARD.email));
  if (CARD.address) L.push("ADR;TYPE=WORK:;;" + v(CARD.address) + ";;;;");
  if (safeUrl(CARD.website)) L.push("URL:" + CARD.website);
  L.push("END:VCARD");
  const blob = new Blob([L.join("\r\n")], { type: "text/vcard;charset=utf-8" });
  const el = document.createElement("a");
  el.href = URL.createObjectURL(blob);
  el.download = (full.replace(/\s+/g, "_") || "contact") + ".vcf";
  document.body.appendChild(el);
  el.click();
  el.remove();
});
</script>
</body>
</html>
