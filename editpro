  if (!a) return;
  if (a === "photo") { if (upBusy) return; photoKey = b.dataset.k; $("file").value = ""; return $("file").click(); }
  if (a === "rmimg") { imgSet(b.dataset.k, ""); dirty = true; return render(); }
  if (a === "delh") M.hours.splice(i, 1);
  else if (a === "dels") { var nm = M.staff[i].n; M.staff.splice(i, 1); M.halls.forEach(function (h) { var k = h.s.indexOf(nm); if (k > -1) h.s.splice(k, 1); }); }
  else if (a === "delz") M.halls.splice(i, 1);
  else if (a === "delc") { if (!confirm(t("confirm"))) return; M.menu.splice(c, 1); }
  else if (a === "deli") { if (!confirm(t("confirm"))) return; M.menu[c].items.splice(i, 1); }
  else if (a === "addi") M.menu[c].items.push({ n: "", d: "", p: "", on: true, img: "" });
  else if (a === "up" && i > 0) { var x = M.menu[c].items; x.splice(i - 1, 0, x.splice(i, 1)[0]); }
  else if (a === "dn") { var y = M.menu[c].items; if (i < y.length - 1) y.splice(i + 1, 0, y.splice(i, 1)[0]); }
  dirty = true; render();
});
/* ---- photo: compress in the browser (square 320px JPEG) then send to Google Drive via the API ---- */
$("file").addEventListener("change", function () {
  var f = this.files && this.files[0]; if (!f) return; var key = photoKey;
  var im = new Image(), u = URL.createObjectURL(f); upBusy = true; say(t("upl"));
  im.onload = function () {
    URL.revokeObjectURL(u);
    var s = Math.min(im.width, im.height), cv = document.createElement("canvas"); cv.width = cv.height = 320;
    cv.getContext("2d").drawImage(im, (im.width - s) / 2, (im.height - s) / 2, s, s, 0, 0, 320, 320);
    var data = cv.toDataURL("image/jpeg", 0.72).split(",")[1];
    fetch(API, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify({ a: "img", s: S, k: K, data: data }) })
      .then(function (r) { return r.json(); })
      .then(function (j) { upBusy = false; if (j.ok) { imgSet(key, j.url); dirty = true; say(""); render(); } else say(t(j.e === "quota" ? "e_quota" : j.e === "key" ? "e_key" : "e_img"), "bad"); })
      .catch(function () { upBusy = false; say(t("e_net"), "bad"); });
  };
  im.onerror = function () { upBusy = false; say(t("e_img"), "bad"); };
  im.src = u;
});
function save() {
  if (upBusy) return;
  var D = M.daily; if (String(D.n || "").trim() && !isNum(D.p)) { say(t("e_price") + " (" + t("daily") + ")", "bad"); return; }
  for (var ci = 0; ci < M.menu.length; ci++) for (var ii = 0; ii < M.menu[ci].items.length; ii++) { var p = String(M.menu[ci].items[ii].p || "").trim(); if (p && !isNum(p)) { say(t("e_price") + " (" + M.menu[ci].items[ii].n + ")", "bad"); return; } }
  for (var si = 0; si < M.staff.length; si++) { var s = M.staff[si]; if ((s.n || s.w) && !/^[0-9+ ]{8,18}$/.test(String(s.w || "").trim())) { say(t("e_num") + " (" + (s.n || "?") + ")", "bad"); return; } }
  $("save").disabled = true; say(t("saving"));
  fetch(API, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify({ a: "save", s: S, k: K, rows: toRows() }) })
    .then(function (r) { return r.json(); })
    .then(function (j) { $("save").disabled = false; if (j.ok) { dirty = false; say(t("saved"), "ok"); } else say(t(j.e === "key" ? "e_key" : "e_net"), "bad"); })
    .catch(function () { $("save").disabled = false; say(t("e_net"), "bad"); });
}
window.addEventListener("beforeunload", function (e) { if (dirty) { e.preventDefault(); e.returnValue = ""; } });
function init() {
  applyLang();
  if (!/^[a-z0-9][a-z0-9-]{1,58}$/.test(S) || K.length < 12 || !API || API.indexOf("__API") === 0) return fail("e_link");
  say(t("loading"));
  $("app").hidden = false;
  fetch(API + (API.indexOf("?") > -1 ? "&" : "?") + "a=load&s=" + encodeURIComponent(S) + "&k=" + encodeURIComponent(K))
    .then(function (r) { return r.text(); })
    .then(function (txt) {
      var j; try { j = JSON.parse(txt); } catch (x) { return fail("e_net", "reponse: " + txt.replace(/\s+/g, " ").slice(0, 80)); }
      if (!j.ok) return fail("e_key", "serveur: " + j.e);
      fromRows(j.rows); $("bar").hidden = false; say(""); render();
    })
    .catch(function (e) { fail("e_net", String(e && e.message || e)); });
}
init();
</script>
